{
  "name": "speckit SDD",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  "postCreateCommand": "pip install uv && npm install -g github:spec-kit/specify-cli",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "GitHub.copilot"
      ]
    },
    "codespaces": {
      "permissions": {
        "actions": "write",
        "contents": "write",
        "workflows": "write"
      }
    }
  }
}
